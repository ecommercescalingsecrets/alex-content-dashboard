# Copy to .env and fill in real values. NEVER commit .env.
# Rotate all of these on 2026-07-30 — the previous values were leaked in git history.

# Railway — Project Access Token from https://railway.com/account/tokens
RAILWAY_TOKEN=

# Railway service + environment IDs (safe to commit, but kept here for one-stop config)
RAILWAY_SERVICE_ID=a9d7fe5a-72a0-4277-b7f4-9d80acddf520
RAILWAY_ENV_ID=db6e86e8-ecb2-4417-85ab-308d9d657dd5

# GitHub PAT with repo scope — https://github.com/settings/tokens
# Only needed if using HTTPS remote; SSH is preferred (no token in filesystem).
GITHUB_TOKEN=

# Gethookd API — https://app.gethookd.ai/integrations/api-mcp
# Needs boards:write scope.
GETHOOKD_API_KEY=

# Twitter/X — used by dashboard for /post-now endpoint
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
